# Copy to ~/.config/systemd/user/ownsei.service and edit both paths.
[Unit]
Description=Ownsei local subtitle workstation
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Apps/Ownsei
ExecStart=/bin/bash %h/Apps/Ownsei/scripts/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
